{
  "name": "dsh-animal-island-theme",
  "version": "0.1.0",
  "type": "module",
  "description": "Animal Island style theme: cream and teal palette, pill controls, Nunito Latin text with tuned CJK spacing.",
  "author": "nagisa-win",
  "license": "MIT",
  "homepage": "https://github.com/nagisa-win/dsh-animal-island-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagisa-win/dsh-animal-island-theme.git"
  },
  "keywords": ["dsh", "dsh-plugin", "theme", "animal-island-ui"],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/fonts/OFL.txt",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
